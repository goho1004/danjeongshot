# 단정샷 — copy from .env.example
GEMINI_API_KEY=
# MOCK_GENERATE=1 → API 키 없이 플레이스홀더 결과 (로컬 플로우 테스트)
MOCK_GENERATE=1
PAYMENT_MODE=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DELETE_TTL_DAYS=7
# 미리보기 어뷰징 한도
# 기기(서명 쿠키)·일 기본 3회 — 재접속만으로 리셋 안 됨
PREVIEW_PER_DEVICE_DAY=3
# IP당 시간 한도 (기본 5)
GENERATE_RATE_LIMIT=5
GENERATE_RATE_WINDOW_MS=3600000
# 같은 사진 반복 미리보기
PREVIEW_SAME_IMAGE_LIMIT=2
# 일 글로벌 하드캡. 0 = 무제한 (이상신호 3단 사용)
DAILY_GEN_BUDGET=0
# 이상신호: 100 알림 · 200 챌린지 · 1000 비상 / 10분 80장 버스트
PREVIEW_ALERT_DAY=100
PREVIEW_CHALLENGE_DAY=200
PREVIEW_EMERGENCY_DAY=1000
PREVIEW_BURST_LIMIT=80
# 수동 비상정지: PREVIEW_EMERGENCY=1
# 선택: Cloudflare Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 선택: 이상신호 웹훅
# ABUSE_WEBHOOK_URL=
# 쿠키 서명용 (미설정 시 GEMINI_API_KEY 사용)
# PREVIEW_QUOTA_SECRET=
# 인스턴스 간 공유 카운터 (권장 · 시크릿/VPN 구멍 축소)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- 토스페이먼츠 (PAYMENT_MODE=toss 일 때) ---
# PAYMENT_MODE=toss
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# --- 사업자·전자상거래 표기 (푸터) ---
# NEXT_PUBLIC_BIZ_TRADE_NAME=증명사진 -단정-
# NEXT_PUBLIC_BIZ_ENTITY_TYPE=개인사업자
# NEXT_PUBLIC_BIZ_CEO=
# NEXT_PUBLIC_BIZ_NO=
# NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=
# NEXT_PUBLIC_BIZ_ADDRESS=
# NEXT_PUBLIC_BIZ_EMAIL=support@danjeongshot.com
# NEXT_PUBLIC_BIZ_PHONE=
# NEXT_PUBLIC_BIZ_VAT_NOTE=표시 금액은 부가세(10%) 포함가입니다. 과세 매출은 전액 신고합니다.
# NEXT_PUBLIC_BIZ_TAX_INVOICE_NOTE=세금계산서·현금영수증은 사업자등록 후 발행합니다.
