# 단정샷 — copy from .env.example
GEMINI_API_KEY=
# MOCK_GENERATE=1 → API 키 없이 플레이스홀더 결과 (로컬 플로우 테스트)
MOCK_GENERATE=1
PAYMENT_MODE=sandbox
# UI 뱃지용 (서버 PAYMENT_MODE와 맞출 것)
NEXT_PUBLIC_PAYMENT_MODE=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DELETE_TTL_DAYS=7
# --- 결제 후 생성 동시·남용 게이트 (/api/generate) ---
# IP 분당 (기본 4)
GENERATE_PER_IP_MINUTE=4
# IP 시간당 (기본 20)
GENERATE_RATE_LIMIT=20
GENERATE_RATE_WINDOW_MS=3600000
# 기기 시간당
GENERATE_PER_DEVICE_HOUR=12
# 전역 분당 캡 (동시 생성 폭주 완화)
GENERATE_GLOBAL_MINUTE=30
# 전역 일일 캡 (0 = 일일 캡 끔)
DAILY_GEN_BUDGET=500
# generate 호출 장부 (링버퍼 · 오래된 것 삭제)
# GENERATE_LOG_MAX=300
# GENERATE_LOG_TTL_DAYS=14
# 비상 정지(생성 전부 바쁨 멘트): PREVIEW_EMERGENCY=1

# 옛 미리보기 쿼터(레거시 · 결제 전에는 생성 자체가 막힘)
PREVIEW_PER_DEVICE_DAY=3
PREVIEW_SAME_IMAGE_LIMIT=2
PREVIEW_ALERT_DAY=100
PREVIEW_CHALLENGE_DAY=200
PREVIEW_EMERGENCY_DAY=1000
PREVIEW_BURST_LIMIT=80
# 선택: Cloudflare Turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 선택: 이상신호 웹훅
# ABUSE_WEBHOOK_URL=
# 쿠키 서명용 (미설정 시 GEMINI_API_KEY 사용)
# PREVIEW_QUOTA_SECRET=
# ★ 인스턴스 간 공유 카운터 (프로덕션 권장 · 미설정 시 메모리만)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# (있으면) 생성 레이트리밋 + 주문 SoT·paid/redo claim 공유 — docs/CONCURRENCY.md


# --- 이메일 전달 (받기 · 인화 PNG) ---
# Resend https://resend.com — 미설정 시 mock(로컬 로그, 주문은 제공개시 처리)
# RESEND_API_KEY=re_...
# DELIVER_FROM=단정샷 <noreply@yourdomain.com>
# DELIVER_TTL_HOURS=48

# --- 토스페이먼츠 (PAYMENT_MODE=toss) ---
# PAYMENT_MODE=toss
# NEXT_PUBLIC_PAYMENT_MODE=toss
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
# TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# --- 사업자·전자상거래 표기 (푸터) ---
# NEXT_PUBLIC_BIZ_TRADE_NAME=증명사진 -단정-
# NEXT_PUBLIC_BIZ_ENTITY_TYPE=개인사업자
# NEXT_PUBLIC_BIZ_CEO=
# NEXT_PUBLIC_BIZ_NO=
# NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=
# NEXT_PUBLIC_BIZ_ADDRESS=
# NEXT_PUBLIC_BIZ_EMAIL=support@danjeongshot.com
# NEXT_PUBLIC_BIZ_PHONE=
# NEXT_PUBLIC_BIZ_VAT_NOTE=표시 금액은 부가세(10%) 포함가입니다. 과세 매출은 전액 신고합니다.
# NEXT_PUBLIC_BIZ_TAX_INVOICE_NOTE=세금계산서·현금영수증은 사업자등록 후 발행합니다.

# --- CS · 와치독 알림 — docs/CS_CHANNEL.md ---
# TELEGRAM_BOT_TOKEN=          # 단정 와치독 전용 Bot (Hermes 봇과 분리)
# TELEGRAM_WATCHDOG_CHAT_ID=   # 업무 알림 받을 chat_id
# CS_CONTACT_PHONE=            # CS 표시용(선택) · 자동 SMS ✗
# OPS_CS_TOKEN=                # /ops/cs 수동 TG 보고 · 프로덕션 필수
# (솔라피·알림톡은 채널 개설 후 선택 — 와치독 기본 경로 ✗)

